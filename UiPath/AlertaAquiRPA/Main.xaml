<Activity mc:Ignorable="sap sap2010" x:Class="Main"
  xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
  xmlns:s="clr-namespace:System;assembly=mscorlib"
  xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
  xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
  xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
  xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib"
  xmlns:sd="clr-namespace:System.Data;assembly=System.Data"
  xmlns:ui="http://schemas.uipath.com/workflow/activities"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <mva:VisualBasic.Settings>
    <x:Null />
  </mva:VisualBasic.Settings>
  <sap2010:WorkflowViewState.IdRef>Main_1</sap2010:WorkflowViewState.IdRef>
  <TextExpression.NamespacesForImplementation>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>Microsoft.VisualBasic</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Collections</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Diagnostics</x:String>
      <x:String>System.IO</x:String>
      <x:String>System.Linq</x:String>
      <x:String>System.Xml</x:String>
      <x:String>System.Xml.Linq</x:String>
      <x:String>UiPath.Core</x:String>
      <x:String>UiPath.Core.Activities</x:String>
      <x:String>UiPath.Excel</x:String>
      <x:String>UiPath.Excel.Activities</x:String>
      <x:String>System.Windows.Markup</x:String>
    </sco:Collection>
  </TextExpression.NamespacesForImplementation>
  <TextExpression.ReferencesForImplementation>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>Microsoft.VisualBasic</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Data.DataSetExtensions</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xml.Linq</AssemblyReference>
      <AssemblyReference>PresentationFramework</AssemblyReference>
      <AssemblyReference>WindowsBase</AssemblyReference>
      <AssemblyReference>PresentationCore</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
      <AssemblyReference>UiPath.System.Activities</AssemblyReference>
      <AssemblyReference>UiPath.UiAutomation.Activities</AssemblyReference>
      <AssemblyReference>UiPath.Excel</AssemblyReference>
      <AssemblyReference>UiPath.Excel.Activities</AssemblyReference>
    </sco:Collection>
  </TextExpression.ReferencesForImplementation>
  <Sequence DisplayName="Main - AlertaAqui RPA" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dtAlertas" />
      <Variable x:TypeArguments="x:String" Name="urlForm" />
      <Variable x:TypeArguments="x:Int32" Default="0" Name="qtdOk" />
      <Variable x:TypeArguments="x:Int32" Default="0" Name="qtdErro" />
    </Sequence.Variables>

    <ui:LogMessage DisplayName="Log Message - Inicio" Level="Info" Message="[&quot;AlertaAqui RPA: inicio do processamento dos boletins da Defesa Civil&quot;]" sap2010:WorkflowViewState.IdRef="LogMessage_1" />

    <Assign DisplayName="Assign - URL do formulario" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[urlForm]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">["file:///" + System.IO.Path.GetFullPath("form.html").Replace("\", "/")]</InArgument>
      </Assign.Value>
    </Assign>

    <ui:ReadRange AddHeaders="True" DataTable="[dtAlertas]" DisplayName="Read Range - alertas_defesa_civil.xlsx" Password="{x:Null}" Range="" SheetName="Alertas" WorkbookPath="alertas_defesa_civil.xlsx" sap2010:WorkflowViewState.IdRef="ReadRange_1" />

    <ui:LogMessage DisplayName="Log Message - Linhas lidas" Level="Info" Message="[&quot;Boletins lidos: &quot; + dtAlertas.Rows.Count.ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_2" />

    <ui:OpenBrowser UiBrowser="{x:Null}" BrowserType="Chrome" DisplayName="Open Browser - Painel Admin" Hidden="False" NewSession="True" Private="False" Url="[urlForm]" sap2010:WorkflowViewState.IdRef="OpenBrowser_1">
      <ui:OpenBrowser.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="ContextTarget" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <ui:ForEachRow CurrentIndex="{x:Null}" DataTable="[dtAlertas]" DisplayName="For Each Row - boletins" sap2010:WorkflowViewState.IdRef="ForEachRow_1">
              <ui:ForEachRow.Body>
                <ActivityAction x:TypeArguments="sd:DataRow">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                  </ActivityAction.Argument>
                  <TryCatch DisplayName="Try Catch - cadastrar alerta" sap2010:WorkflowViewState.IdRef="TryCatch_1">
                    <TryCatch.Try>
                      <Sequence DisplayName="Cadastrar alerta" sap2010:WorkflowViewState.IdRef="Sequence_3">

                        <ui:TypeInto AlterIfDisabled="{x:Null}" DelayBefore="{x:Null}" DelayBetweenKeys="{x:Null}" DelayMS="{x:Null}" Activate="True" ClickBeforeTyping="True" DisplayName="Type Into - Regiao" EmptyField="True" SendWindowMessages="False" SimulateType="True" Text="[row(&quot;Regiao&quot;).ToString.Trim]" sap2010:WorkflowViewState.IdRef="TypeInto_1">
                          <ui:TypeInto.Target>
                            <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Selector="&lt;html app='chrome.exe' title='AlertaAqui*' /&gt;&lt;webctrl id='regiao' tag='INPUT' /&gt;" TimeoutMS="{x:Null}" WaitForReady="COMPLETE" />
                          </ui:TypeInto.Target>
                        </ui:TypeInto>

                        <ui:SelectItem DelayAfter="{x:Null}" DelayBefore="{x:Null}" DisplayName="Select Item - Nivel de risco" Item="[row(&quot;NivelRisco&quot;).ToString.Trim]" sap2010:WorkflowViewState.IdRef="SelectItem_1">
                          <ui:SelectItem.Target>
                            <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Selector="&lt;html app='chrome.exe' title='AlertaAqui*' /&gt;&lt;webctrl id='nivel' tag='SELECT' /&gt;" TimeoutMS="{x:Null}" WaitForReady="COMPLETE" />
                          </ui:SelectItem.Target>
                        </ui:SelectItem>

                        <ui:TypeInto AlterIfDisabled="{x:Null}" DelayBefore="{x:Null}" DelayBetweenKeys="{x:Null}" DelayMS="{x:Null}" Activate="True" ClickBeforeTyping="True" DisplayName="Type Into - Mensagem" EmptyField="True" SendWindowMessages="False" SimulateType="True" Text="[row(&quot;Mensagem&quot;).ToString.Trim]" sap2010:WorkflowViewState.IdRef="TypeInto_2">
                          <ui:TypeInto.Target>
                            <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Selector="&lt;html app='chrome.exe' title='AlertaAqui*' /&gt;&lt;webctrl id='mensagem' tag='TEXTAREA' /&gt;" TimeoutMS="{x:Null}" WaitForReady="COMPLETE" />
                          </ui:TypeInto.Target>
                        </ui:TypeInto>

                        <ui:TypeInto AlterIfDisabled="{x:Null}" DelayBefore="{x:Null}" DelayBetweenKeys="{x:Null}" DelayMS="{x:Null}" Activate="True" ClickBeforeTyping="True" DisplayName="Type Into - Data" EmptyField="False" SendWindowMessages="False" SimulateType="False" Text="[Convert.ToDateTime(row(&quot;Data&quot;)).ToString(&quot;ddMMyyyy&quot;)]" sap2010:WorkflowViewState.IdRef="TypeInto_3">
                          <ui:TypeInto.Target>
                            <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Selector="&lt;html app='chrome.exe' title='AlertaAqui*' /&gt;&lt;webctrl id='data' tag='INPUT' /&gt;" TimeoutMS="{x:Null}" WaitForReady="COMPLETE" />
                          </ui:TypeInto.Target>
                        </ui:TypeInto>

                        <ui:Click DelayBefore="{x:Null}" DelayMS="{x:Null}" ClickType="CLICK_SINGLE" DisplayName="Click - Enviar" KeyModifiers="None" MouseButton="BTN_LEFT" SendWindowMessages="False" SimulateClick="True" sap2010:WorkflowViewState.IdRef="Click_1">
                          <ui:Click.CursorPosition>
                            <ui:CursorPosition Position="Center">
                              <ui:CursorPosition.OffsetX>
                                <InArgument x:TypeArguments="x:Int32" />
                              </ui:CursorPosition.OffsetX>
                              <ui:CursorPosition.OffsetY>
                                <InArgument x:TypeArguments="x:Int32" />
                              </ui:CursorPosition.OffsetY>
                            </ui:CursorPosition>
                          </ui:Click.CursorPosition>
                          <ui:Click.Target>
                            <ui:Target ClippingRegion="{x:Null}" Element="{x:Null}" Selector="&lt;html app='chrome.exe' title='AlertaAqui*' /&gt;&lt;webctrl id='btnEnviar' tag='BUTTON' /&gt;" TimeoutMS="{x:Null}" WaitForReady="COMPLETE" />
                          </ui:Click.Target>
                        </ui:Click>

                        <Assign DisplayName="Assign - qtdOk + 1" sap2010:WorkflowViewState.IdRef="Assign_2">
                          <Assign.To>
                            <OutArgument x:TypeArguments="x:Int32">[qtdOk]</OutArgument>
                          </Assign.To>
                          <Assign.Value>
                            <InArgument x:TypeArguments="x:Int32">[qtdOk + 1]</InArgument>
                          </Assign.Value>
                        </Assign>

                        <ui:LogMessage DisplayName="Log Message - Alerta cadastrado" Level="Info" Message="[&quot;Alerta cadastrado: &quot; + row(&quot;Regiao&quot;).ToString + &quot; | &quot; + row(&quot;NivelRisco&quot;).ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_3" />
                      </Sequence>
                    </TryCatch.Try>
                    <TryCatch.Catches>
                      <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_1">
                        <ActivityAction x:TypeArguments="s:Exception">
                          <ActivityAction.Argument>
                            <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                          </ActivityAction.Argument>
                          <Sequence DisplayName="Tratar erro" sap2010:WorkflowViewState.IdRef="Sequence_4">
                            <Assign DisplayName="Assign - qtdErro + 1" sap2010:WorkflowViewState.IdRef="Assign_3">
                              <Assign.To>
                                <OutArgument x:TypeArguments="x:Int32">[qtdErro]</OutArgument>
                              </Assign.To>
                              <Assign.Value>
                                <InArgument x:TypeArguments="x:Int32">[qtdErro + 1]</InArgument>
                              </Assign.Value>
                            </Assign>
                            <ui:LogMessage DisplayName="Log Message - Erro" Level="Error" Message="[&quot;Falha ao cadastrar alerta da regiao &quot; + row(&quot;Regiao&quot;).ToString + &quot;: &quot; + exception.Message]" sap2010:WorkflowViewState.IdRef="LogMessage_4" />
                          </Sequence>
                        </ActivityAction>
                      </Catch>
                    </TryCatch.Catches>
                  </TryCatch>
                </ActivityAction>
              </ui:ForEachRow.Body>
            </ui:ForEachRow>
          </Sequence>
        </ActivityAction>
      </ui:OpenBrowser.Body>
    </ui:OpenBrowser>

    <ui:LogMessage DisplayName="Log Message - Fim" Level="Info" Message="[&quot;AlertaAqui RPA finalizado. Sucesso: &quot; + qtdOk.ToString + &quot; | Erros: &quot; + qtdErro.ToString]" sap2010:WorkflowViewState.IdRef="LogMessage_5" />
  </Sequence>
</Activity>
